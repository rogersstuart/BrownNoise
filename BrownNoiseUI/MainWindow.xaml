<Window x:Class="BrownNoiseUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Brown Noise Generator" Height="400" Width="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Sample Rate:"/>
            <TextBox Grid.Row="0" Grid.Column="1" Name="textBoxSampleRate" Text="44100" Margin="5"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Duration (seconds):"/>
            <TextBox Grid.Row="1" Grid.Column="1" Name="textBoxDuration" Text="60" TextChanged="TextBoxDuration_TextChanged" Margin="5"/>

            <Label Grid.Row="2" Grid.Column="0" Content="Bit Depth:"/>
            <ComboBox Grid.Row="2" Grid.Column="1" Name="comboBoxBitDepth" SelectedIndex="0" Margin="5">
                <ComboBoxItem>16</ComboBoxItem>
                <ComboBoxItem>24</ComboBoxItem>
                <ComboBoxItem>32</ComboBoxItem>
            </ComboBox>

            <Label Grid.Row="3" Grid.Column="0" Content="Channels:"/>
            <ComboBox Grid.Row="3" Grid.Column="1" Name="comboBoxChannels" SelectedIndex="0" Margin="5">
                <ComboBoxItem>Mono</ComboBoxItem>
                <ComboBoxItem>Stereo</ComboBoxItem>
            </ComboBox>

            <Label Grid.Row="4" Grid.Column="0" Content="Output File:"/>
            <Grid Grid.Row="4" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Name="textBoxOutputFile" Margin="5"/>
                <Button Grid.Column="1" Content="Browse..." Click="ButtonBrowse_Click" Margin="5" Padding="10,5"/>
            </Grid>

            <Label Grid.Row="5" Grid.Column="0" Content="Leakiness:"/>
            <Grid Grid.Row="5" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0" Name="sliderLeakiness" Minimum="1" Maximum="60" Value="60" 
                        ValueChanged="SliderLeakiness_ValueChanged" Margin="5"/>
                <TextBox Grid.Column="1" Name="textBoxLeakiness" Text="60" Width="50" Margin="5"
                         TextChanged="TextBoxLeakiness_TextChanged"/>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="buttonGenerate" Content="Generate" Click="ButtonGenerate_Click" 
                    Margin="5" Padding="20,10" IsDefault="True"/>
            <Button Name="buttonClose" Content="Close" Click="ButtonClose_Click" 
                    Margin="5" Padding="20,10" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>